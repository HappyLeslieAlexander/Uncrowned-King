+#[tokio::test]
+async fn audit_rejected_reload_must_preserve_active_ca_cache() {
+    let path = std::env::temp_dir().join(format!("audit-ca-rejected-reload-{}.pem", std::process::id()));
+    std::fs::write(&path, include_str!("../../../../audit-ca-one.pem")).unwrap();
+    let mut config = minimal_config();
+    config.ca_cert_path = path.to_string_lossy().into_owned();
+    crate::check_config(&config).unwrap();
+    let old_tls = crate::tls::shared_client_config(&config.ca_cert_path).await.unwrap();
+    let manager = test_session_manager(config.clone());
+    std::fs::write(&path, include_str!("../../../../audit-ca-two.pem")).unwrap();
+    config.max_socks_connections = Some(config.max_socks_connections() + 1);
+    let error = manager.reload(config.clone()).await.unwrap_err();
+    assert!(error.to_string().contains("requires a restart"));
+    assert_eq!(manager.config.generation(), 1);
+    let active_tls = crate::tls::shared_client_config(&config.ca_cert_path).await.unwrap();
+    eprintln!("audit rejected reload: error={error}, generation={}, CA cache same={}", manager.config.generation(), Arc::ptr_eq(&old_tls, &active_tls));
+    std::fs::remove_file(path).unwrap();
+    assert!(Arc::ptr_eq(&old_tls, &active_tls), "rejected reload replaced active cached TLS trust");
+}
