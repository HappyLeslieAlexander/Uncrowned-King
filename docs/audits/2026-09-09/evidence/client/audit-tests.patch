+#[tokio::test]
+async fn audit_udp_old_session_completion_must_not_remove_new_session_flow() {
+    let old_session = test_session(8, 8);
+    let new_session = test_session(8, 8);
+    let target = Target::Ipv4(Ipv4Addr::LOCALHOST, 12345);
+    let socket = Arc::new(UdpSocket::bind("127.0.0.1:0").await.unwrap());
+    let (event_tx, _event_rx) = mpsc::channel(8);
+    let mut association = UdpAssociation::new(socket, None, event_tx,
+        socks5::SocksEndpoint::Ipv4(Ipv4Addr::UNSPECIFIED, 0), CONTROL_PEER_IP);
+    let old_id = old_session.reserve_flow(FlowProtocol::Udp).await.unwrap().unwrap().0;
+    let new_id = new_session.reserve_flow(FlowProtocol::Udp).await.unwrap().unwrap().0;
+    assert_eq!(old_id, new_id, "ids restart per carrier");
+    association.flows_by_target.insert(target.clone(), UdpAssociationFlow {
+        id: new_id, session: new_session.clone(), last_activity: time::Instant::now(),
+    });
+    association.handle_flow_task_result(Some(Ok(UdpFlowTaskResult {
+        flow_id: old_id, target: target.clone(), outcome: Ok(()),
+    })));
+    assert!(association.flows_by_target.contains_key(&target), "old carrier completion removed new carrier flow with the same id");
+}
