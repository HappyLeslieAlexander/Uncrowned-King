+#[tokio::test]
+async fn audit_udp_control_reset_leaves_orphan_route() {
+    let session = test_session(8, 8);
+    let mut raw = Arc::try_unwrap(session).ok().unwrap();
+    let (writer, mut mock_peer) = tokio::io::duplex(65536);
+    raw.writer = Arc::new(Mutex::new(Box::new(writer)));
+    let session = Arc::new(raw);
+    let manager = Arc::new(test_session_manager(minimal_config()));
+    manager.pool.lock().await.push(session.clone());
+    let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let mut control = TcpStream::connect(listener.local_addr().unwrap()).await.unwrap();
+    let (accepted, _) = listener.accept().await.unwrap();
+    let (shutdown_tx, shutdown_rx) = watch::channel(false);
+    let relay = tokio::spawn(relay_udp_association(
+        accepted, manager.clone(), socks5::SocksEndpoint::Ipv4(Ipv4Addr::UNSPECIFIED, 0), shutdown_rx,
+    ));
+    let mut reply = [0; 10];
+    control.read_exact(&mut reply).await.unwrap();
+    let relay_addr = SocketAddr::from((Ipv4Addr::new(reply[4],reply[5],reply[6],reply[7]), u16::from_be_bytes([reply[8],reply[9]])));
+    let udp = UdpSocket::bind("127.0.0.1:0").await.unwrap();
+    let target = Target::Ipv4(Ipv4Addr::LOCALHOST, 12345);
+    udp.send_to(&socks5::encode_udp_datagram(&target, b"ping").unwrap(), relay_addr).await.unwrap();
+    let open = time::timeout(Duration::from_secs(1), read_frame(&mut mock_peer, FrameLimits::default())).await.unwrap().unwrap();
+    assert_eq!(open.header.frame_type, FrameType::UdpOpen);
+    handle_carrier_frame(&session, Frame::new(FrameType::UdpData, 0, open.header.id, Bytes::new()).unwrap()).await.unwrap();
+    let data = time::timeout(Duration::from_secs(1), read_frame(&mut mock_peer, FrameLimits::default())).await.unwrap().unwrap();
+    assert_eq!(data.header.frame_type, FrameType::UdpData);
+    socket2::SockRef::from(&control).set_linger(Some(Duration::ZERO)).unwrap();
+    drop(control);
+    let result = time::timeout(Duration::from_secs(2), relay).await.unwrap().unwrap();
+    assert!(result.is_err(), "RST must be an error to reproduce");
+    for _ in 0..5 { tokio::task::yield_now().await; }
+    let retained = session.flows.lock().await.len();
+    eprintln!("audit control RST: routes retained={retained}, available_udp_permits={}", session.admission.available_udp_flows());
+    assert_eq!(retained, 0, "association error must remove its routes");
+    drop(shutdown_tx);
+}
