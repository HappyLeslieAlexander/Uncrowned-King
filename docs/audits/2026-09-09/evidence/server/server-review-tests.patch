+#[tokio::test]
+async fn review_drain_drops_data_after_both_half_closes() {
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let relay_socket = TcpStream::connect(listener.local_addr().unwrap()).await.unwrap();
+    let (mut target, _) = listener.accept().await.unwrap();
+    let (_, target_writer) = relay_socket.into_split();
+    let (tx, rx) = mpsc::channel(10);
+    let flow_control = TargetFlowControl::default();
+    let mut flow = TargetFlow::new(TEST_FLOW_TOKEN, tx, flow_control.clone());
+    flow.mark_target_to_client_closed();
+    flow.enqueue_data(Bytes::from_static(b"last request bytes"), 1000, 1000).unwrap();
+    flow.close_client_to_target();
+    assert!(flow.is_fully_closed());
+    drop(flow); // Same remove_flow_slot path after client TCP_CLOSE.
+    let (event_tx, _event_rx) = mpsc::channel(10);
+    let shutdown = SessionShutdown::default();
+    let writer = CarrierWriter::new(Box::new(tokio::io::sink()), shutdown.clone(), Arc::new(ServerMetrics::default()), Some(Duration::from_secs(1)));
+    let mut tasks = SessionTasks::default();
+    spawn_target_writer(&mut tasks, TargetWriterTask { identity: TargetFlowIdentity { flow_id: 1, token: TEST_FLOW_TOKEN }, target_writer, commands: rx, flow_control, carrier_writer: writer.clone(), event_tx, shutdown: shutdown.clone(), write_timeout: Some(Duration::from_secs(1)) });
+    let mut state = ServerSessionState::Draining;
+    let mut table = FlowTable::new();
+    // Draining loop sees empty table and invokes this while writer has queued bytes.
+    close_session(&mut state, &shutdown, &mut table, &mut tasks, &writer, Some(Duration::from_secs(1))).await;
+    let mut received = Vec::new();
+    target.read_to_end(&mut received).await.unwrap();
+    assert_eq!(received, b"last request bytes", "drain acknowledged both closes but discarded queued target data");
+}
