+#[tokio::test]
+async fn review_aborted_flow_still_sends_queued_data() {
+    let listener = tokio::net::TcpListener::bind("127.0.0.1:0").await.unwrap();
+    let relay_socket = TcpStream::connect(listener.local_addr().unwrap()).await.unwrap();
+    let (mut target, _) = listener.accept().await.unwrap();
+    let (reader, _) = relay_socket.into_split();
+    let shutdown = SessionShutdown::default();
+    let control = TargetFlowControl::default();
+    let (carrier_output, mut carrier_input) = tokio::io::duplex(1000);
+    let writer = CarrierWriter::new(Box::new(carrier_output), shutdown.clone(), Arc::new(ServerMetrics::default()), Some(Duration::from_secs(1)));
+    let guard = writer.inner.lock().await;
+    let (event_tx, _event_rx) = mpsc::channel(10);
+    let task_control = control.clone(); let task_writer = writer.clone(); let task_shutdown = shutdown.clone();
+    target.write_all(b"stale target bytes").await.unwrap();
+    let task = tokio::spawn(async move { relay_target_to_client(1, reader, task_control, &task_writer, &event_tx, &task_shutdown, 100).await });
+    tokio::time::sleep(Duration::from_millis(30)).await;
+    control.abort(); // Client closes ID 1 while old reader waits for carrier lock.
+    drop(guard);
+    task.await.unwrap().unwrap();
+    assert!(tokio::time::timeout(Duration::from_millis(30), read_frame(&mut carrier_input, FrameLimits::default())).await.is_err(), "old flow emitted data after abort instead of discarding queued frame");
+}
