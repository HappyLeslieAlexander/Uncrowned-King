+#[cfg(test)]
+mod review_settings_tests {
+    use super::*;
+    use std::pin::Pin;
+    use std::task::{Context, Poll};
+    struct Stall;
+    impl tokio::io::AsyncWrite for Stall {
+        fn poll_write(self: Pin<&mut Self>, _: &mut Context<'_>, _: &[u8]) -> Poll<io::Result<usize>> { Poll::Pending }
+        fn poll_flush(self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<io::Result<()>> { Poll::Pending }
+        fn poll_shutdown(self: Pin<&mut Self>, _: &mut Context<'_>) -> Poll<io::Result<()>> { Poll::Pending }
+    }
+    #[tokio::test]
+    async fn review_settings_write_holds_session_after_shutdown() {
+        let config: ServerConfig = toml::from_str(include_str!("../../../examples/server.toml")).unwrap();
+        let cred = uk_auth::Credential::active(b"client".to_vec(), b"0123456789abcdef0123456789abcdef".to_vec()).unwrap();
+        let identity = AuthenticatedIdentity::from(&cred);
+        let security = SecurityState::new(crate::security::test_tls_acceptor(), vec![cred], uk_policy::PolicySet::default(), Duration::from_secs(30));
+        let permits = Arc::new(Semaphore::new(1));
+        let task_permits = permits.clone();
+        let (tx, rx) = watch::channel(false);
+        let handle = tokio::spawn(async move { run_authenticated_session(Box::new(tokio::io::empty()), Box::new(Stall), None, identity, security, &config, task_permits, 1, "127.0.0.1:1000".parse().unwrap(), rx, Arc::new(ServerMetrics::default())).await });
+        tokio::task::yield_now().await;
+        assert_eq!(permits.available_permits(), 0);
+        tx.send(true).unwrap();
+        let result = time::timeout(Duration::from_millis(100), handle).await;
+        assert!(result.is_ok(), "SETTINGS write ignores shutdown and has no write deadline; slot remains held");
+    }
+}
